"diffserv4 – 4 tins: Bulk / Best-Effort / Streaming / Voice (recommended)"
msgstr "diffserv4: 4 tin: Bulk / Best-Effort / Streaming / Voice (recomendado)"

#: luci-app-antilag/www/luci-static/resources/view/antilag.js:213
msgid "diffserv8 – 8 tins mapped to DSCP CS0–CS7"
msgstr "diffserv8: 8 tin asignados a DSCP CS0–CS7"

