#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/sbin/antilag

# start_instance – one UCI section.
#
# Dynamic instances run as a procd-managed daemon (one process per
# instance).  Static instances are stateless fixed-rate shapers, the
# sqm-scripts model: apply the CAKE qdiscs now and let the iface hotplug
# hook re-apply them whenever the interface comes up.
start_instance() {
    local cfg="$1"
    local enabled mode

    config_get_bool enabled "$cfg" enabled 0
    [ "$enabled" -eq 1 ] || return 0

    config_get mode "$cfg" mode dynamic
    if [ "$mode" = "static" ]; then
        "$PROG" apply "$cfg" || \
            logger -t antilag "failed to apply static instance '$cfg'"
        return 0
    fi

    procd_open_instance "$cfg"
    procd_set_param command "$PROG" run "$cfg"
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

# stop_static_instance – tear down a static instance named in UCI.
stop_static_instance() {
    local cfg="$1"
    local enabled mode

    config_get_bool enabled "$cfg" enabled 0
    [ "$enabled" -eq 1 ] || return 0

    config_get mode "$cfg" mode dynamic
    [ "$mode" = "static" ] && "$PROG" stop "$cfg"
    return 0
}

# stop_orphans – static instances whose UCI section was deleted.  The
# state file written by `apply` records the interfaces so the qdiscs can
# still be removed.
stop_orphans() {
    local f sid

    for f in /var/run/antilag-*.state; do
        [ -e "$f" ] || continue
        sid="${f##*/antilag-}"
        sid="${sid%.state}"
        "$PROG" stop "$sid"
    done
}

start_service() {
    config_load antilag
    config_foreach start_instance antilag
}

stop_service() {
    config_load antilag
    config_foreach stop_static_instance antilag
    stop_orphans
    return 0
}

reload_service() {
    # Use restart rather than stop+start.
    #
    # stop+start is unreliable here because procd only calls reload_service
    # on services that are already registered (running).  When the user
    # enables the service for the first time (enabled 0→1) there is no
    # running instance, so stop is a no-op and procd may silently skip the
    # subsequent start.  restart() in rc.common handles both the cold-start
    # and the already-running cases correctly.
    restart
}

service_triggers() {
    procd_add_reload_trigger antilag
}
